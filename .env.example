# Copy this file to .env and fill in what you need.
# Loaded automatically: `import minisweagent` loads it (see src/minisweagent/__init__.py),
# and `just` auto-loads it for every recipe too (see `set dotenv-load` in the justfile).

# --- Model provider API keys (read directly by litellm; set whichever you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
REQUESTY_API_KEY=
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=

# --- mini-swe-agent settings (see src/minisweagent/__init__.py and models/__init__.py) ---
# Default model for run scripts when -m/--model is omitted.
MSWEA_MODEL_NAME=
# Skip the interactive `mini-extra config setup` first-run prompt.
MSWEA_CONFIGURED=true
# Silence the startup version banner (useful for scripted/test runs).
MSWEA_SILENT_STARTUP=1
